# 站点配置
SITE_NAME=MoonTV
ANNOUNCEMENT=本网站仅提供影视信息搜索服务，所有内容均来自第三方网站。本站不存储任何视频资源，不对任何内容的准确性、合法性、完整性负责。

# 存储类型 (localstorage | redis | d1 | upstash)
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# ---------------------------------------------------------------------------
# 代理地址：按平台选择（豆瓣 CDN 有防盗链，必须走代理）
#
#   EdgeOne Makers（Next.js 路由可原样返回图片流）：
#     NEXT_PUBLIC_IMAGE_PROXY=/api/image-proxy?url=
#     NEXT_PUBLIC_DOUBAN_PROXY=/douban-proxy?url=     (cloud-functions/douban-proxy.js)
#
#   Netlify（Next.js 运行时会把图片响应包装成 JSON，必须用独立 Function）：
#     NEXT_PUBLIC_IMAGE_PROXY=/.netlify/functions/image-proxy?url=
#     NEXT_PUBLIC_DOUBAN_PROXY=/.netlify/functions/image-proxy?url=
# ---------------------------------------------------------------------------

# 图片代理 - 用于代理豆瓣等外站图片
NEXT_PUBLIC_IMAGE_PROXY=/api/image-proxy?url=

# 豆瓣代理 - 用于代理豆瓣 API 数据请求
NEXT_PUBLIC_DOUBAN_PROXY=/api/image-proxy?url=

# 是否启用注册功能
NEXT_PUBLIC_ENABLE_REGISTER=false

# 是否禁用黄色内容过滤
NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false

# 搜索最大翻页数
NEXT_PUBLIC_SEARCH_MAX_PAGE=10