# 站点配置
SITE_NAME=MoonTV
ANNOUNCEMENT=本网站仅提供影视信息搜索服务，所有内容均来自第三方网站。本站不存储任何视频资源，不对任何内容的准确性、合法性、完整性负责。

# 存储类型 (localstorage | redis | d1 | upstash)
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# 图片代理 - 用于代理豆瓣等外站图片
NEXT_PUBLIC_IMAGE_PROXY=/api/image-proxy?url=

# 豆瓣代理 - 用于代理豆瓣 API 数据请求
NEXT_PUBLIC_DOUBAN_PROXY=/api/image-proxy?url=

# 是否启用注册功能
NEXT_PUBLIC_ENABLE_REGISTER=false

# 是否禁用黄色内容过滤
NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false